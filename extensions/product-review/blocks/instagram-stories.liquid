{{ 'instagram-stories.css' | asset_url | stylesheet_tag }}

<div
  id="igs-widget-{{ block.id }}"
  class="igs-widget"
  {{ block.shopify_attributes }}
  data-shop="{{ shop.permanent_domain }}"
  data-duration="{{ block.settings.photo_seconds }}"
  style="--igs-size: {{ block.settings.circle_size }}px; --igs-pt: {{ block.settings.padding_top }}px; --igs-pb: {{ block.settings.padding_bottom }}px; --igs-align: {{ block.settings.align }};"
>
  {% if block.settings.heading != blank %}
    <h2 class="igs-heading">{{ block.settings.heading }}</h2>
  {% endif %}
  <div class="igs-body"></div>
</div>

<script src="{{ 'instagram-stories.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Instagram Stories",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    { "type": "range", "id": "circle_size", "label": "Circle size", "min": 64, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "photo_seconds", "label": "Seconds per photo story", "min": 3, "max": 10, "step": 1, "default": 5 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ]
}
{% endschema %}
