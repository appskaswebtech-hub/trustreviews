{{ 'reviews-summary.css' | asset_url | stylesheet_tag }}

<div
  class="rs-section"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-locale="{{ request.locale.iso_code }}"
  data-show-verified="{{ block.settings.show_verified_badge }}"
  data-seo-enabled="{{ block.settings.enable_seo_schema }}"
>
  <h2 class="rs-heading">{{ block.settings.heading | default: "Customer Reviews" }}</h2>

  <div class="rs-summary-row">
    <div class="rs-summary-left">
      <div class="rs-avg-stars" id="rs-avg-stars"></div>
      <div class="rs-avg-line"><span id="rs-avg-rating" class="tr-extensions-product-review-blocks-reviews-summary-span-1">0.0</span> <span id="rs-out-of" class="tr-extensions-product-review-blocks-reviews-summary-span-2">out of 5</span></div>
      <div class="rs-total"><span id="rs-based-on-label" class="tr-extensions-product-review-blocks-reviews-summary-span-3">Based on</span> <span id="rs-total-reviews" class="tr-extensions-product-review-blocks-reviews-summary-span-4">0</span> <span id="rs-reviews-word" class="tr-extensions-product-review-blocks-reviews-summary-span-5">reviews</span></div>
    </div>

    <div class="rs-breakdown" id="rs-breakdown"></div>

    {% if block.settings.show_write_review %}
      <button id="rs-open-review" class="rs-write-btn"><span id="rs-write-label" class="tr-extensions-product-review-blocks-reviews-summary-span-6">Write a Review</span></button>
    {% endif %}
  </div>

  {% if block.settings.badge_image_1 or block.settings.badge_image_2 or block.settings.badge_image_3 %}
    <div class="rs-badges">
      {% if block.settings.badge_image_1 %}
        <div class="rs-badge">
          <img src="{{ block.settings.badge_image_1 | image_url: width: 90 }}" width="90" height="90" alt="{{ block.settings.badge_label_1 | escape }}" loading="lazy" class="tr-extensions-product-review-blocks-reviews-summary-img-7">
          {% if block.settings.badge_label_1 != blank %}<span class="tr-extensions-product-review-blocks-reviews-summary-span-8">{{ block.settings.badge_label_1 }}</span>{% endif %}
        </div>
      {% endif %}
      {% if block.settings.badge_image_2 %}
        <div class="rs-badge">
          <img src="{{ block.settings.badge_image_2 | image_url: width: 90 }}" width="90" height="90" alt="{{ block.settings.badge_label_2 | escape }}" loading="lazy" class="tr-extensions-product-review-blocks-reviews-summary-img-9">
          {% if block.settings.badge_label_2 != blank %}<span class="tr-extensions-product-review-blocks-reviews-summary-span-10">{{ block.settings.badge_label_2 }}</span>{% endif %}
        </div>
      {% endif %}
      {% if block.settings.badge_image_3 %}
        <div class="rs-badge">
          <img src="{{ block.settings.badge_image_3 | image_url: width: 90 }}" width="90" height="90" alt="{{ block.settings.badge_label_3 | escape }}" loading="lazy" class="tr-extensions-product-review-blocks-reviews-summary-img-11">
          {% if block.settings.badge_label_3 != blank %}<span class="tr-extensions-product-review-blocks-reviews-summary-span-12">{{ block.settings.badge_label_3 }}</span>{% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.show_write_review %}
    <div id="rs-review-form" class="rs-review-form" style="display:none">
      <div class="rs-form-header">
        <h3 id="rs-form-title" class="tr-extensions-product-review-blocks-reviews-summary-h3-13">Write a Review</h3>
        <button class="rs-form-close" id="rs-form-close-btn" aria-label="Close" onclick="rsCloseReview()">✕</button>
      </div>
      <div class="rs-form-field">
        <label class="tr-extensions-product-review-blocks-reviews-summary-label-14"><span id="rs-rating-question" class="tr-extensions-product-review-blocks-reviews-summary-span-15">What would you rate this product?</span> <span class="rs-required">*</span></label>
        <div class="rs-star-rating" id="rs-star-rating">
          <span data-value="1" class="tr-extensions-product-review-blocks-reviews-summary-span-16">★</span>
          <span data-value="2" class="tr-extensions-product-review-blocks-reviews-summary-span-17">★</span>
          <span data-value="3" class="tr-extensions-product-review-blocks-reviews-summary-span-18">★</span>
          <span data-value="4" class="tr-extensions-product-review-blocks-reviews-summary-span-19">★</span>
          <span data-value="5" class="tr-extensions-product-review-blocks-reviews-summary-span-20">★</span>
        </div>
      </div>
      <div class="rs-form-field">
        <label id="rs-review-title-label" class="tr-extensions-product-review-blocks-reviews-summary-label-21">Review title</label>
        <input type="text" id="rs-review-title" placeholder="Summarize your experience..." class="tr-extensions-product-review-blocks-reviews-summary-input-22">
      </div>
      <div class="rs-form-field">
        <label class="tr-extensions-product-review-blocks-reviews-summary-label-23"><span id="rs-feedback-label" class="tr-extensions-product-review-blocks-reviews-summary-span-24">Tell us your feedback about the product</span> <span class="rs-required">*</span></label>
        <textarea id="rs-comment" placeholder="Share your experience with this product..." required class="tr-extensions-product-review-blocks-reviews-summary-textarea-25"></textarea>
      </div>
      <div class="rs-form-field">
        <label id="rs-upload-label" class="tr-extensions-product-review-blocks-reviews-summary-label-26">Upload image/video</label>
        <input type="file" id="rs-review-file" accept="image/*,video/*" onchange="rsPreviewFile(event)" class="tr-extensions-product-review-blocks-reviews-summary-input-27">
        <div id="rs-file-preview" class="rs-file-preview"></div>
      </div>
      <div class="rs-dubble-field">
        <div class="rs-form-field">
          <label class="tr-extensions-product-review-blocks-reviews-summary-label-28"><span id="rs-name-label" class="tr-extensions-product-review-blocks-reviews-summary-span-29">Your name</span> <span class="rs-required">*</span></label>
          <input type="text" id="rs-name" placeholder="Name" required class="tr-extensions-product-review-blocks-reviews-summary-input-30">
        </div>
        <div class="rs-form-field">
          <label class="tr-extensions-product-review-blocks-reviews-summary-label-31"><span id="rs-email-label" class="tr-extensions-product-review-blocks-reviews-summary-span-32">Your email address</span> <span class="rs-required">*</span></label>
          <input type="email" id="rs-email" placeholder="Email" required class="tr-extensions-product-review-blocks-reviews-summary-input-33">
        </div>
      </div>
      <div class="rs-form-actions">
        <button onclick="rsCloseReview()" id="rs-cancel-btn" class="rs-cancel-btn">Cancel</button>
        <button onclick="rsSubmitReview()" id="rs-submit-btn" class="rs-submit-btn">Submit</button>
      </div>
    </div>
  {% endif %}

  <div class="rs-toolbar">
    <div class="rs-sort-wrap">
      <button class="rs-sort-btn" id="rs-sort-btn" onclick="rsToggleSortMenu()">Most Recent ▾</button>
      <div class="rs-sort-menu" id="rs-sort-menu" style="display:none">
        <div class="rs-sort-option active" data-sort="newest" onclick="rsSelectSort(this)">Most Recent</div>
        <div class="rs-sort-option" data-sort="oldest" onclick="rsSelectSort(this)">Oldest First</div>
        <div class="rs-sort-option" data-sort="highest" onclick="rsSelectSort(this)">Highest Rated</div>
        <div class="rs-sort-option" data-sort="lowest" onclick="rsSelectSort(this)">Lowest Rated</div>
        <div class="rs-sort-option" data-sort="helpful" onclick="rsSelectSort(this)">Most Helpful</div>
      </div>
    </div>
  </div>

  <div id="rs-no-results" style="display:none" class="rs-no-results">No reviews yet.</div>
  <div id="rs-review-list" class="tr-extensions-product-review-blocks-reviews-summary-div-34"></div>
  <div id="rs-pagination" class="rs-pagination" style="display:none"></div>
  <div id="rs-toast-container" class="rs-toast-container"></div>
</div>


<script src="{{ 'reviews-summary.js' | asset_url }}" defer class="tr-extensions-product-review-blocks-reviews-summary-script-35"></script>

{% schema %}
{
  "name": "Reviews Summary",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "checkbox", "id": "show_write_review", "label": "Show \"Write a Review\" button and form", "default": true },
    { "type": "checkbox", "id": "show_verified_badge", "label": "Show \"Verified\" badge on every review", "default": true },
    { "type": "header", "content": "Trust badges (optional)" },
    { "type": "image_picker", "id": "badge_image_1", "label": "Badge 1 image" },
    { "type": "text", "id": "badge_label_1", "label": "Badge 1 label" },
    { "type": "image_picker", "id": "badge_image_2", "label": "Badge 2 image" },
    { "type": "text", "id": "badge_label_2", "label": "Badge 2 label" },
    { "type": "image_picker", "id": "badge_image_3", "label": "Badge 3 image" },
    { "type": "text", "id": "badge_label_3", "label": "Badge 3 label" },
    { "type": "header", "content": "SEO" },
    { "type": "checkbox", "id": "enable_seo_schema", "label": "Enable SEO Rich Snippets (Google star ratings in search)", "default": true }
  ]
}
{% endschema %}
