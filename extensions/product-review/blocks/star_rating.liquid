<span style="color:{{ block.settings.colour }}" class="tr-extensions-product-review-blocks-star-rating-span-1">
  <span id="api-star-rating-{{ block.id }}" class="tr-extensions-product-review-blocks-star-rating-span-2">☆☆☆☆☆</span>
</span>

<span id="api-avg-rating-{{ block.id }}" class="tr-extensions-product-review-blocks-star-rating-span-3">0.0</span>/5

<script class="tr-extensions-product-review-blocks-star-rating-script-4">
  (function () {
    const productId = "{{ block.settings.product.id | default: product.id }}";
    const ratingEl = document.getElementById("api-star-rating-{{ block.id }}");
    const avgEl = document.getElementById("api-avg-rating-{{ block.id }}");

    if (!productId || !ratingEl || !avgEl) return;

    async function loadAverageRating() {
      try {
        const res = await fetch(`/apps/review?productId=${encodeURIComponent(productId)}`);
        if (!res.ok) throw new Error("Unable to load rating");

        const data = await res.json();

        const total = Number(data.total || 0);
        const avgValue = Number(data.averageRating || 0);
        const roundedRating = Math.round(avgValue);

        avgEl.innerText = total ? avgValue.toFixed(1) : "0.0";

        let stars = "";
        for (let i = 1; i <= 5; i++) {
          stars += i <= roundedRating ? "★" : "☆";
        }

        ratingEl.innerText = stars;
      } catch (error) {
        console.error("Average rating error:", error);
      }
    }

    loadAverageRating();
  })();
</script>

{% render 'block-position', widget: 'star_rating_badge', spot: 'under_title', position: block.settings.position, block_id: block.id %}

{% schema %}
{
  "name": "Star Rating Badge",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {"type": "select", "id": "position", "label": "Position", "default": "auto", "options": [{"value": "auto", "label": "Automatic (recommended)"}, {"value": "under_title", "label": "Under the product title"}, {"value": "here", "label": "Where I place the block"}], "info": "Automatic: added from the Trust Reviews app → shows under the product title. Blocks you placed yourself stay where they are."},
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "color",
      "id": "colour",
      "label": "Star Colour",
      "default": "#ff0000"
    }
  ]
}
{% endschema %}
