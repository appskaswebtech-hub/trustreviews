<div class="review-section">
  <div class="nr-review-top-hed-wr">
    <!-- AVERAGE RATING SUMMARY -->
    <div class="review-summary">
      <div class="summary-inner">
        <div class="nr-review-main-hed">
          <div class="avg-score">
            <span id="avg-rating">0</span><span class="out-of">/5</span>
          </div>
          <div class="avg-stars" id="avg-stars"></div>
        </div>
        <div class="total-reviews"><span id="based-on-label">Based on</span> <span id="total-reviews">0</span> <span id="reviews-word">reviews</span></div>
      </div>
    </div>
    {% if block.settings.show_write_review %}
    <button id="open-review" class="review-btn">Write a Review</button>
    <div id="review-form" class="review-form" style="display:none">
      <div class="form-header">
        <h3 id="form-title">Write a Review</h3>
        <button class="form-close" id="form-close-btn" aria-label="Close" onclick="closeReview()">✕</button>
      </div>
      <div class="form-field">
        <label><span id="rating-question">What would you rate this product?</span> <span class="required">*</span></label>
        <div class="star-rating" id="star-rating">
          <span data-value="1">★</span>
          <span data-value="2">★</span>
          <span data-value="3">★</span>
          <span data-value="4">★</span>
          <span data-value="5">★</span>
        </div>
      </div>
      <div class="form-field">
        <label id="review-title-label">Review title</label>
        <input type="text" id="review-title" placeholder="Summarize your experience...">
      </div>
      <div class="form-field">
        <label><span id="feedback-label">Tell us your feedback about the product</span> <span class="required">*</span></label>
        <textarea id="comment" placeholder="Share your experience with this product..." required></textarea>
        <div class="form-field">
        <label id="upload-label">Upload image/video</label>
        <input
          type="file"
          id="review-file"
          accept="image/*,video/*"
          onchange="previewReviewFile(event)"
        >
        <div id="file-preview" class="file-preview"></div>
      </div>
      </div>
      <div class="nr-dubble-field">
        <div class="form-field-row">
          <div class="form-field">
            <label><span id="name-label">Your name</span> <span class="required">*</span></label>
            <input type="text" id="name" placeholder="Name" required>
          </div>
        </div>
        <div class="form-field-row">
          <div class="form-field">
            <label><span id="email-label">Your email address</span> <span class="required">*</span></label>
            <input type="email" id="email" placeholder="Email" required>
          </div>
        </div>
      </div>
      <div class="form-actions">
        <button onclick="closeReview()" id="cancel-btn" class="cancel-btn">Cancel</button>
        <button onclick="submitReview()" id="submit-btn" class="submit-btn">Submit</button>
      </div>
    </div>
    {% endif %}

  </div>

  <!-- REVIEWS LIST -->
  <div class="reviews-section">
    <div class="reviews-toolbar">
      <div class="toolbar-tabs">
        <span class="tab active" id="reviews-tab-label">Product Reviews</span>
      </div>
      <div class="toolbar-right">

        <!-- SORT DROPDOWN -->
        <div class="sort-wrap">
          <button class="sort-btn" id="sort-btn" onclick="toggleSortMenu()">Sort ▾</button>
          <div class="sort-menu" id="sort-menu" style="display:none">
            <div class="sort-option active" data-sort="newest" onclick="selectSort(this)">Newest First</div>
            <div class="sort-option" data-sort="oldest" onclick="selectSort(this)">Oldest First</div>
            <div class="sort-option" data-sort="highest" onclick="selectSort(this)">Highest Rated</div>
            <div class="sort-option" data-sort="lowest" onclick="selectSort(this)">Lowest Rated</div>
            <div class="sort-option" data-sort="helpful" onclick="selectSort(this)">Most Helpful</div>
          </div>
        </div>

        <!-- SEARCH BOX -->
        <div class="search-wrap">
          <button class="search-btn" id="search-toggle-btn" aria-label="Search reviews" onclick="toggleSearch()">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M14.9536 14.9458L21 21M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
            <span id="search-label">Search</span>
          </button>
          <div class="search-box" id="search-box" style="display:none">
            <input type="text" id="search-input" placeholder="Search reviews..." oninput="renderReviews()">
            <button class="search-clear" id="search-clear-btn" aria-label="Clear search" onclick="clearSearch()">✕</button>
          </div>
        </div>

      </div>
    </div>

    <!-- NO RESULTS MESSAGE -->
    <div id="no-results" style="display:none" class="no-results">No reviews match your search.</div>

    <div id="review-list"></div>

    <!-- PAGINATION -->
    <div id="review-pagination" class="review-pagination" style="display:none"></div>
  </div>

  <!-- TOAST CONTAINER -->
  <div id="toast-container" class="toast-container"></div>

<style>
/* ============ BASE ============ */
.review-section {
  width: 100%;
  max-width: 100%;
  margin: 60px 0;
  padding: 0 40px;
  font-family: var(--rf-font, 'Helvetica Neue', Helvetica, Arial, sans-serif);
  color: #1a1a1a;
}

/* ============ WRITE REVIEW BUTTON ============ */
.review-btn {
  display: inline-block;
  padding: 11px 22px;
  background: var(--rf-accent, #000);
  color: var(--rf-btn-text, #fff);
  border: 1.5px solid var(--rf-accent, #1a1a1a);
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  border-radius: var(--rf-radius, 3px);
  letter-spacing: 0.3px;
  transition: background 0.18s, color 0.18s;
}
.review-btn:hover {
  background: var(--rf-accent, #1a1a1a);
  color: var(--rf-btn-text, #fff);
}

/* ============ FORM ============ */
.review-form {
  background: var(--rf-bg, transparent);
  border: 0;
  border-radius: 6px;
  padding: 30px 30px 24px;
  margin-bottom: 32px;
  width: 100%;
}
.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}
.form-header h3 {
  font-size: 17px;
  font-weight: 700;
  margin: 0;
}
.form-close {
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: #888;
  line-height: 1;
  padding: 0;
}
.form-close:hover { color: #333; }

.form-field-row {
  margin-bottom: 16px;
  width: 100%;
}
@media (max-width: 600px) {
  .form-field-row { grid-template-columns: 1fr; }
}

.form-field {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
}
.form-field label {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 7px;
  color: #333;
}
.required { color: #e53935; }

.form-field input,
.form-field textarea {
  padding: 10px 13px;
  border: 1.5px solid #ddd;
  border-radius: var(--rf-radius, 0px);
  font-size: 14px;
  font-family: inherit;
  color: #1a1a1a;
  background: #fafafa;
  transition: border-color 0.15s;
  outline: none;
  display: flex;
  align-items: center;
}
.form-field input:focus,
.form-field textarea:focus {
  border-color: #1a1a1a;
  background: #fff;
}
.form-field textarea {
  min-height: 110px;
  resize: vertical;
}

/* ============ STAR RATING ============ */
.star-rating {
  display: flex;
  gap: 4px;
  font-size: 30px;
  cursor: pointer;
  margin-top: 4px;
}
.star-rating span {
  color: #ddd;
  transition: color 0.12s, transform 0.1s;
  line-height: 1;
}
.star-rating span.active { color: var(--rf-accent, #000); }
.star-rating span:hover { transform: scale(1.15); }

/* ============ FORM ACTIONS ============ */
.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}
.submit-btn {
  padding: 10px 26px;
  background: var(--rf-accent, #1a1a1a);
  color: var(--rf-btn-text, #fff);
  border: none;
  border-radius: var(--rf-radius, 3px);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.18s;
}
.submit-btn:hover { opacity: 0.88; }
.cancel-btn {
  padding: 10px 20px;
  background: #fff;
  color: #555;
  border: 1.5px solid #ddd;
  border-radius: 3px;
  font-size: 14px;
  cursor: pointer;
  transition: border-color 0.15s;
}
.cancel-btn:hover { border-color: #999; }

/* ============ SUMMARY ============ */
.avg-score {
  font-size: 38px;
  font-weight: 800;
  line-height: 1;
  color: #1a1a1a;
}
.out-of {
  font-size: 22px;
  font-weight: 400;
  color: #888;
}
.avg-stars {
  font-size: 22px;
  color: #000;
  margin: 7px 0 5px;
}
.total-reviews {
  font-size: 13px;
  color: #888;
}

/* ============ REVIEWS SECTION ============ */
.reviews-section { margin-top: 32px; }
.reviews-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #000;
  border-top: 1px solid #000;
  padding: 20px 0;
  margin-bottom: 0;
  flex-wrap: wrap;
  gap: 8px;
  flex-direction: row-reverse;
}
.toolbar-tabs { display: flex; gap: 0; }
.tab {
  font-size: 14px;
  font-weight: 600;
  padding: 0px 0px 8px;
  cursor: pointer;
  color: #aaa;
  border-bottom: 2.5px solid transparent;
  margin-bottom: -2px;
  transition: color 0.15s, border-color 0.15s;
}
.tab.active {
  color: #1a1a1a;
  border-bottom-color: #1a1a1a;
}
.toolbar-right {
  display: flex;
  gap: 10px;
  align-items: center;
  padding-bottom: 6px;
  flex-wrap: wrap;
}

/* ============ SORT ============ */
.sort-wrap { position: relative; }
.sort-btn {
  font-size: 16px;
  color: #000000;
  cursor: pointer;
  padding: 0;
  border: 0;
  border-radius: 3px;
  background: transparent;
  transition: background 0.15s;
  white-space: nowrap;
  font-weight: 600;
}
.sort-btn:hover, .sort-btn.open { background: #f0f0f0; border-color: #bbb; }
.sort-menu {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  background: #fff;
  border: 1.5px solid #e0e0e0;
  border-radius: 5px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.10);
  z-index: 100;
  min-width: 160px;
  overflow: hidden;
}
.sort-option {
  padding: 10px 16px;
  font-size: 13px;
  color: #333;
  cursor: pointer;
  transition: background 0.12s;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
.sort-option:hover { background: #f5f5f5; }
.sort-option.active {
  font-weight: 700;
  color: #1a1a1a;
  background: #f0f0f0;
}

/* ============ SEARCH ============ */
.search-wrap { position: relative; display: flex; align-items: center; gap: 6px; }
.search-btn {
  font-size: 13px;
  color: #555;
  cursor: pointer;
  padding: 6px 12px;
  border: 0;
  border-radius: 3px;
  background: transparent;
  transition: background 0.15s;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 5px;
}
.search-btn:hover, .search-btn.open { background: #f0f0f0; border-color: #bbb; }
.search-box {
  display: flex;
  align-items: center;
  border: 1.5px solid #1a1a1a;
  border-radius: 3px;
  background: #fff;
  overflow: hidden;
  animation: slideIn 0.15s ease;
}
@keyframes slideIn {
  from { opacity: 0; transform: translateX(8px); }
  to   { opacity: 1; transform: translateX(0); }
}
.search-box input {
  border: none;
  outline: none;
  padding: 6px 10px;
  font-size: 13px;
  font-family: inherit;
  color: #1a1a1a;
  width: 180px;
  background: transparent;
}
.search-clear {
  background: none;
  border: none;
  cursor: pointer;
  color: #aaa;
  font-size: 14px;
  padding: 0 8px;
  line-height: 1;
  transition: color 0.12s;
}
.search-clear:hover { color: #1a1a1a; }

/* ============ NO RESULTS ============ */
.no-results {
  padding: 32px 0;
  text-align: center;
  color: #aaa;
  font-size: 14px;
}

/* ============ REVIEW CARD ============ */
.review-card {
  display: flex;
  padding: 24px 0;
  border-bottom: 1px solid var(--rl-card-border, #000);
  align-items: flex-start;
  background: var(--rl-card-bg, transparent);
}
.review-avatar {
  flex-shrink: 0;
  width: 60px;
  height: 60px;
  background: #0000001a;
  background: color-mix(in srgb, var(--rl-accent, #000) 10%, transparent);
  color: var(--rl-accent, #000);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding-right: 0px;
}
.review-avatar-outer {
  margin-right: 20px;
  width: 15%;
}
.review-body {
  flex: 1;
  min-width: 0;
  padding-left: 20px;
  border-left: 1px solid var(--rl-card-border, #000);
  width: 85%;
  color: var(--rl-card-text, #333);
}
.review-stars {
  font-size: 17px;
  color: var(--rl-accent, #000);
  margin-bottom: 4px;
  display: flex;
  gap: 2px;
}
.review-stars .dim { color: #ddd; }

/* ── Grid layout ── */
.reviews-section[data-list-style="grid"] #review-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.review-card--grid {
  flex-direction: column;
  align-items: stretch;
  padding: 18px;
  border: 1px solid var(--rl-card-border, #000);
  border-radius: 10px;
}
.review-card--grid .review-avatar-outer {
  width: auto;
  margin-right: 0;
  margin-bottom: 0;
}
.review-card--grid .review-body {
  border-left: 0;
  padding-left: 0;
  width: 100%;
}
.review-card--grid .review-card-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}
.review-card--grid .review-avatar { width: 32px; height: 32px; font-size: 11px; background: var(--rl-accent, #000); color: #fff; }
@media (max-width: 700px) {
  .reviews-section[data-list-style="grid"] #review-list { grid-template-columns: 1fr; }
}

/* ── Compact layout ── */
.review-card--compact {
  padding: 12px 0;
  align-items: center;
  gap: 10px;
}
.review-card--compact .review-avatar-outer { width: auto; margin-right: 0; }
.review-card--compact .review-avatar { width: 30px; height: 30px; font-size: 11px; background: var(--rl-accent, #000); color: #fff; }
.review-card--compact .review-body { border-left: 0; padding-left: 0; width: 100%; }
.review-card--compact .review-card-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 2px;
}
.review-card--compact .review-stars { font-size: 13px; margin-bottom: 0; }
.review-card--compact .review-comment { margin: 2px 0 0; font-size: 13px; }

/* ── Minimal List layout (icon avatar, full-width divider rows) ── */
.review-card--minimal {
  display: block;
  padding: 18px 0;
}
.review-card--minimal .review-card-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 6px 0 10px;
}
.review-avatar-icon {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #f0f0f0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}
.review-title-line {
  font-size: 14px;
  font-weight: 700;
  color: var(--rl-card-text, #1a1a1a);
  margin-bottom: 4px;
}
.review-card--minimal .review-comment { margin: 0; }

/* ============ PAGINATION ============ */
.review-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
  padding: 24px 0 8px;
}
.pagination-arrow,
.pagination-num {
  background: none;
  border: 1.5px solid #ddd;
  border-radius: 4px;
  min-width: 32px;
  height: 32px;
  padding: 0 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--rl-card-text, #333);
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s, color 0.15s;
}
.pagination-arrow:hover:not(:disabled),
.pagination-num:hover:not(.active) { border-color: var(--rl-accent, #000); background: #f7f7f7; }
.pagination-arrow:disabled { opacity: 0.35; cursor: default; }
.pagination-num.active {
  background: var(--rl-accent, #1a1a1a);
  border-color: var(--rl-accent, #1a1a1a);
  color: #fff;
  cursor: default;
}
.pagination-ellipsis { font-size: 13px; color: #888; padding: 0 4px; }
.review-product-label {
  font-size: 13px;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 4px;
}
.review-author {
  font-size: 13px;
  color: #888;
  margin-bottom: 8px;
}
.review-comment {
  font-size: 14px;
  color: #333;
  line-height: 1.6;
  margin: 0 0 12px;
}
.review-reply {
  background: var(--rl-card-bg, #f9fafb);
  border-left: 3px solid var(--rl-accent, #1a1a1a);
  border-radius: 4px;
  padding: 8px 12px;
  font-size: 13px;
  color: var(--rl-card-text, #444);
  margin: 0 0 12px;
  line-height: 1.5;
}
.review-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}
.helpful-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  background: none;
  border: 1.2px solid #ddd;
  border-radius: 3px;
  padding: 5px 12px;
  font-size: 12.5px;
  cursor: pointer;
  color: #555;
  transition: border-color 0.15s, background 0.15s;
}
.helpful-btn:hover { border-color: #1a1a1a; background: #f7f7f7; }
.helpful-btn .check { color: #2e7d32; font-weight: 700; }
.share-btn {
  background: none;
  border: none;
  font-size: 12.5px;
  color: #888;
  cursor: pointer;
  padding: 5px 0;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.share-btn:hover { color: #1a1a1a; }

/* ============ HIGHLIGHT ============ */
.highlight {
  background: #fff3cd;
  border-radius: 2px;
  padding: 0 1px;
}

/* ============ LAYOUT ============ */
.nr-review-top-hed-wr {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}
.nr-review-main-hed {
  display: flex;
  gap: 10px;
  align-items: center;
}
.review-summary .summary-inner {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.search-btn svg {
  height: 20px;
  width: 20px;
}
.nr-dubble-field {
  display: flex;
  gap: 10px;
}

/* ============ TOAST ============ */
.toast-container {
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}
.toast {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 16px;
  border-radius: 6px;
  font-size: 14px;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-weight: 500;
  min-width: 260px;
  max-width: 360px;
  pointer-events: all;
  box-shadow: 0 4px 20px rgba(0,0,0,0.13);
  animation: toastIn 0.25s ease forwards;
  position: relative;
  overflow: hidden;
}
.toast.removing {
  animation: toastOut 0.25s ease forwards;
}
.toast-success {
  background: #1a1a1a;
  color: #fff;
}
.toast-error {
  background: #fff;
  color: #1a1a1a;
  border: 1.5px solid #e53935;
}
.toast-icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
}
.toast-success .toast-icon {
  background: rgba(255,255,255,0.15);
  color: #fff;
}
.toast-error .toast-icon {
  background: #fce8e8;
  color: #e53935;
}
.toast-msg {
  flex: 1;
  line-height: 1.4;
}
.toast-close {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 15px;
  line-height: 1;
  padding: 0;
  margin-left: 4px;
  opacity: 0.45;
  transition: opacity 0.15s;
  flex-shrink: 0;
}
.toast-success .toast-close { color: #fff; }
.toast-error .toast-close { color: #1a1a1a; }
.toast-close:hover { opacity: 1; }
.toast-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 3px;
  animation: toastProgress 3.5s linear forwards;
}
.toast-success .toast-progress { background: rgba(255,255,255,0.30); }
.toast-error .toast-progress { background: #e53935; }
@keyframes toastIn {
  from { opacity: 0; transform: translateX(30px); }
