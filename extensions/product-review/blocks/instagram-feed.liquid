{{ 'instagram-feed.css' | asset_url | stylesheet_tag }}

<div
  id="igf-widget-{{ block.id }}"
  class="igf-widget"
  {{ block.shopify_attributes }}
  data-shop="{{ shop.permanent_domain }}"
  data-layout="{{ block.settings.layout }}"
  data-columns="{{ block.settings.columns }}"
  data-max="{{ block.settings.max_posts }}"
  data-header="{{ block.settings.show_header }}"
  data-caption="{{ block.settings.show_caption }}"
  data-click="{{ block.settings.on_click }}"
  data-follow-text="{{ block.settings.follow_text | escape }}"
  style="--igf-radius: {{ block.settings.corner_radius }}px; --igf-gap: {{ block.settings.gap }}px; --igf-pt: {{ block.settings.padding_top }}px; --igf-pb: {{ block.settings.padding_bottom }}px;"
>
  {% if block.settings.heading != blank %}
    <h2 class="igf-heading">{{ block.settings.heading }}</h2>
  {% endif %}
  <div class="igf-head"></div>
  <div class="igf-body"></div>
</div>

<script src="{{ 'instagram-feed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Instagram Feed",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow us on Instagram" },
    { "type": "checkbox", "id": "show_header", "label": "Show profile name and Follow button", "default": true },
    { "type": "text", "id": "follow_text", "label": "Follow button text", "default": "Follow" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel (swipe)" }
      ]
    },
    { "type": "range", "id": "columns", "label": "Posts per row (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "max_posts", "label": "Max posts", "min": 4, "max": 30, "step": 2, "default": 8 },
    { "type": "checkbox", "id": "show_caption", "label": "Show caption on hover", "default": true },
    {
      "type": "select",
      "id": "on_click",
      "label": "When a post is clicked",
      "default": "popup",
      "options": [
        { "value": "popup", "label": "Open in a popup" },
        { "value": "instagram", "label": "Open on Instagram" }
      ]
    },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ]
}
{% endschema %}
