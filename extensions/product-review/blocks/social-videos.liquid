{{ 'social-videos.css' | asset_url | stylesheet_tag }}

<div
  id="sv-widget-{{ block.id }}"
  class="sv-widget"
  {{ block.shopify_attributes }}
  data-shop="{{ shop.permanent_domain }}"
  data-layout="{{ block.settings.layout }}"
  data-columns="{{ block.settings.columns }}"
  data-max="{{ block.settings.max_videos }}"
  style="--sv-radius: {{ block.settings.corner_radius }}px; --sv-gap: {{ block.settings.gap }}px; --sv-pt: {{ block.settings.padding_top }}px; --sv-pb: {{ block.settings.padding_bottom }}px;"
>
  {% if block.settings.heading != blank %}
    <h2 class="sv-heading">{{ block.settings.heading }}</h2>
  {% endif %}
  <div class="sv-body"></div>
</div>

<script src="{{ 'social-videos.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Social Videos",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch & shop our reels" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Carousel (swipe)" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    { "type": "range", "id": "columns", "label": "Videos per row (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "max_videos", "label": "Max videos", "min": 4, "max": 24, "step": 2, "default": 12 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ]
}
{% endschema %}
