{{ 'homepage-reviews.css' | asset_url | stylesheet_tag }}

{% assign hr_product_id = '' %}
{% if product and product.id %}
  {% assign hr_product_id = product.id | json %}
{% endif %}

<div
  id="hr-widget-{{ block.id }}"
  class="hr-widget"
  {{ block.shopify_attributes }}
  data-shop="{{ shop.permanent_domain }}"
  data-product-id="{{ hr_product_id }}"
  data-block-id="{{ block.id }}"
  data-locale="{{ request.locale.iso_code }}"
  data-seo-enabled="{{ block.settings.enable_seo_schema }}"
  data-max="{{ block.settings.max_reviews }}"
  data-layout="{{ block.settings.layout_style }}"
  data-widget-key="homepage_reviews"
>
  <h2 class="hr-heading">{{ block.settings.heading }}</h2>
  <div class="hr-loading">Loading reviews...</div>
  <div class="hr-body"></div>
</div>

<script src="{{ 'homepage-reviews.js' | asset_url }}" defer class="tr-extensions-product-review-blocks-homepage-reviews-script-1"></script>

{% schema %}
{
  "name": "Homepage Reviews",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "default": "app",
      "info": "“Same as app” uses the layout chosen in Trust Reviews → Widgets → Homepage Reviews. Pick a layout here to give this block its own design, so each Homepage Reviews block can look different. Advanced layouts need the Advanced plan.",
      "options": [
        { "value": "app",              "label": "Same as app" },
        { "value": "summary_carousel", "label": "Summary + Carousel" },
        { "value": "grid",             "label": "Card Grid" },
        { "value": "masonry",          "label": "Masonry" },
        { "value": "spotlight",        "label": "Spotlight" },
        { "value": "ticker",           "label": "Scrolling Ticker" },
        { "value": "hero_banner",      "label": "Hero Banner (Advanced)" },
        { "value": "split_screen",     "label": "Split Screen (Advanced)" },
        { "value": "marquee_strip",    "label": "Marquee Strip (Advanced)" },
        { "value": "video_showcase",   "label": "Video Showcase (Advanced)" },
        { "value": "stacked_cards",    "label": "Stacked Cards (Advanced)" },
        { "value": "stats_dashboard",  "label": "Stats Dashboard (Advanced)" },
        { "value": "accordion_panels", "label": "Accordion Panels (Advanced)" },
        { "value": "story_circles",    "label": "Story Circles (Advanced)" }
      ]
    },
    {
      "type": "range",
      "id": "max_reviews",
      "label": "Max reviews",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    { "type": "header", "content": "SEO" },
    { "type": "checkbox", "id": "enable_seo_schema", "label": "Enable SEO Rich Snippets (Organization schema for search)", "default": true }
  ]
}
{% endschema %}
