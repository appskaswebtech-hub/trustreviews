<div id="google-reviews-{{ block.id }}" class="google-reviews" style="display:none"></div>

<style class="tr-extensions-product-review-blocks-google-reviews-style-1">
.google-reviews { box-sizing: border-box; }
.google-reviews * { box-sizing: border-box; }
.gr-g { display:inline-flex; font-weight:700; letter-spacing:-.02em; }
.gr-g span:nth-child(1){ color:#4285F4 } .gr-g span:nth-child(2){ color:#EA4335 }
.gr-g span:nth-child(3){ color:#FBBC05 } .gr-g span:nth-child(4){ color:#4285F4 }
.gr-g span:nth-child(5){ color:#34A853 } .gr-g span:nth-child(6){ color:#EA4335 }
.gr-stars { letter-spacing:1px; white-space:nowrap; }
.gr-avatar { display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; font-weight:700; flex-shrink:0; }
.gr-ticker-track { animation: gr-scroll 18s linear infinite; }
@media (prefers-reduced-motion: reduce) { .gr-ticker-track { animation:none; } }
@keyframes gr-scroll { from{ transform:translateX(0); } to{ transform:translateX(-50%); } }
.gr-nav-btn { border:none; background:none; cursor:pointer; font-size:18px; line-height:1; padding:4px; }
</style>

<script src="{{ 'google-reviews.js' | asset_url }}" id="tr-gr-js-{{ block.id }}" defer class="tr-extensions-product-review-blocks-google-reviews-script-2"></script>
<script>
(function () {
  // Runs once the deferred script is ready: on page load, or right away when
  // the Theme Editor re-renders the section after the script already loaded.
  var done = false;
  function go() {
    if (done || !window.TrustGoogleReviews) return;
    done = true;
    window.TrustGoogleReviews(document.getElementById('google-reviews-{{ block.id }}'), {{ request.locale.iso_code | json }});
  }
  go();
  var s = document.getElementById('tr-gr-js-{{ block.id }}');
  if (s) s.addEventListener('load', go);
  document.addEventListener('DOMContentLoaded', go);
})();
</script>

{% schema %}
{
  "name": "Google Reviews",
  "target": "section",
  "settings": []
}
{% endschema %}
