{% comment %}
  Trust Reviews — Inline Star Rating block
  • Renders an inline "★★★★★ 4.6 out of 5 based on 1,634 reviews" badge for the current product.
  • Auto-initialises any <div data-trust-product-id="{{ product.id }}"></div> elements on the page.
  • Auto-initialises any <span data-trust-count="{{ product.id }}"></span> elements (count-only badge).
  • Uses localStorage to cache rating data (1-hour TTL) so repeat visits render instantly.
{% endcomment %}

<span
  id="trust-ir-{{ block.id }}"
  class="trust-inline-rating"
  data-product-id="{{ product.id }}"
  data-shop="{{ shop.permanent_domain }}"
  style="display:inline-flex;align-items:center;gap:6px;flex-wrap:wrap;line-height:1;"
>
  <span class="trust-ir__stars" style="display:inline-flex;align-items:center;gap:{{ block.settings.star_gap }}px;font-size:{{ block.settings.star_size }}px;">
    {% for i in (1..5) %}<span style="color:#ddd;">&#9733;</span>{% endfor %}
  </span>
  {% if block.settings.show_text %}
  <span class="trust-ir__text" style="font-size:{{ block.settings.star_size | times: 0.8 | round }}px;color:{{ block.settings.text_color }};"></span>
  {% endif %}
</span>

<script>
(function () {
  var SHOP       = {{ shop.permanent_domain | json }};
  var LOCALE     = {{ request.locale.iso_code | json }};
  var STAR_COLOR = {{ block.settings.star_color | json }};
  var TEXT_COLOR = {{ block.settings.text_color | json }};
  var STAR_SIZE  = {{ block.settings.star_size }};
  var STAR_GAP   = {{ block.settings.star_gap }};
  var SHOW_TEXT  = {{ block.settings.show_text | json }};
  var FORMAT     = {{ block.settings.text_format | json }};
  var CACHE_TTL  = 3600000; // 1 hour in ms
  var PRODUCT_TITLE = {{ product.title | json }};

  // Only called for the block's own product-page instance (not the generic
  // shortcode elements, which can show other products' ratings on collection
  // pages where a page-level Product schema wouldn't make sense).
  function injectRatingSchema(avg, total) {
    if (!PRODUCT_TITLE || !total) return;
    var aggRating = { '@type': 'AggregateRating', 'ratingValue': avg.toFixed(1), 'reviewCount': String(total), 'bestRating': '5', 'worstRating': '1' };

    var scripts = document.querySelectorAll('script[type="application/ld+json"]');
    for (var si = 0; si < scripts.length; si++) {
      var sc = scripts[si];
      var parsed;
      try { parsed = JSON.parse(sc.textContent); } catch (e) { continue; }
      var arr = Array.isArray(parsed) ? parsed : [parsed];
      var matched = false;
      for (var ni = 0; ni < arr.length; ni++) {
        if (arr[ni] && arr[ni]['@type'] === 'Product') {
          arr[ni]['aggregateRating'] = aggRating;
          matched = true;
          break;
        }
      }
      if (matched) { sc.textContent = JSON.stringify(parsed); return; }
    }

    var sid = 'tr-ir-ld-json';
    if (document.getElementById(sid)) return;
    var schema = { '@context': 'https://schema.org/', '@type': 'Product', 'name': PRODUCT_TITLE, 'aggregateRating': aggRating };
    var newSc = document.createElement('script'); newSc.id = sid; newSc.type = 'application/ld+json'; newSc.textContent = JSON.stringify(schema); document.head.appendChild(newSc);
  }

  function starsHTML(avg) {
    var out = '';
    for (var i = 0; i < 5; i++) {
      var color = i < Math.round(avg) ? STAR_COLOR : '#ddd';
      out += '<span style="color:' + color + '">&#9733;</span>';
    }
    return out;
  }

  function formatText(avg, total, t) {
    var n = total.toLocaleString();
    var r = (t && t.reviewsWord) || 'reviews';
    var o = (t && t.outOf5)     || 'out of 5';
    if (FORMAT === 'short') return avg.toFixed(1) + ' (' + n + ' ' + r + ')';
    if (FORMAT === 'count') return n + ' ' + r;
    return avg.toFixed(1) + ' ' + o + ' · ' + n + ' ' + r;
  }

  // Cache key includes locale so switching language fetches fresh data
  function cacheKey(productId) {
    return 'tr-ir-' + SHOP + '-' + productId + '-' + LOCALE;
  }

  function readCache(productId) {
    try {
      var raw = localStorage.getItem(cacheKey(productId));
      if (!raw) return null;
      var parsed = JSON.parse(raw);
      if (Date.now() - parsed.ts < CACHE_TTL) return parsed;
    } catch (e) {}
    return null;
  }

  function writeCache(productId, avg, total, t) {
    try {
      localStorage.setItem(cacheKey(productId), JSON.stringify({ avg: avg, total: total, t: t, ts: Date.now() }));
    } catch (e) {}
  }

  function applyToStarEl(el, avg) {
    if (!avg) { el.style.display = 'none'; return; }
    el.style.display    = 'inline-flex';
    el.style.alignItems = 'center';
    el.style.gap        = STAR_GAP + 'px';
    el.style.fontSize   = STAR_SIZE + 'px';
    el.innerHTML        = starsHTML(avg);
  }

  function renderEl(el, avg, total, t) {
    if (!avg) { el.style.display = 'none'; return; }
    var starsEl = el.querySelector('.trust-ir__stars');
    var textEl  = el.querySelector('.trust-ir__text');
    if (starsEl) applyToStarEl(starsEl, avg);
    if (textEl && SHOW_TEXT) textEl.textContent = formatText(avg, total, t);
  }

  function renderCountEl(el, avg, total, t) {
    if (!total) { el.style.display = 'none'; return; }
    var r = (t && t.reviewsWord) || 'reviews';
    el.style.display    = 'inline-flex';
    el.style.alignItems = 'center';
    el.style.gap        = '4px';
    el.innerHTML =
      '<span style="font-weight:700;color:' + STAR_COLOR + '">' + total.toLocaleString() + '</span>' +
      '<span style="color:#6b7280;font-size:0.9em"> ' + r + '</span>';
  }

  function populate(el, productId, isCountOnly, isPrimaryProduct) {
    if (el.dataset.trDone) return;
    el.dataset.trDone = '1';

    var cached = readCache(productId);
    if (cached) {
      if (isCountOnly) renderCountEl(el, cached.avg, cached.total, cached.t);
      else             renderEl(el, cached.avg, cached.total, cached.t);
      if (isPrimaryProduct) injectRatingSchema(cached.avg, cached.total);
    }

    fetch('/apps/review?shop=' + SHOP + '&productId=' + productId + '&locale=' + encodeURIComponent(LOCALE))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var avg   = d.averageRating || 0;
        var total = d.total || 0;
        var t     = d.translations || {};
        writeCache(productId, avg, total, t);
        if (isCountOnly) renderCountEl(el, avg, total, t);
        else             renderEl(el, avg, total, t);
        if (isPrimaryProduct) injectRatingSchema(avg, total);
      })
      .catch(function () {});
  }

  // Initialise the block element itself — the only instance schema
  // injection applies to, since it's tied to the current page's own
  // product.id (shortcode elements elsewhere on the page may show ratings
  // for other products, e.g. on a collection grid).
  var blockEl = document.getElementById('trust-ir-{{ block.id }}');
  if (blockEl && blockEl.dataset.productId) populate(blockEl, blockEl.dataset.productId, false, true);

  // Auto-initialise <div data-trust-product-id="..."> shortcode elements
  document.querySelectorAll('[data-trust-product-id]:not([data-tr-done])').forEach(function (el) {
    var pid = el.dataset.trustProductId;
    el.innerHTML =
      '<span class="trust-ir__stars" style="display:inline-flex;align-items:center;gap:' + STAR_GAP + 'px;font-size:' + STAR_SIZE + 'px;">' +
        '<span style="color:#ddd">&#9733;</span>'.repeat(5) +
      '</span>' +
      (SHOW_TEXT ? '<span class="trust-ir__text" style="font-size:' + Math.round(STAR_SIZE * 0.8) + 'px;color:' + TEXT_COLOR + ';margin-left:6px;"></span>' : '');
    el.style.cssText += ';display:inline-flex!important;align-items:center;gap:6px;flex-wrap:wrap;';
    populate(el, pid, false);
  });

  // Auto-initialise <span data-trust-count="..."> count-only shortcode elements
  document.querySelectorAll('[data-trust-count]:not([data-tr-done])').forEach(function (el) {
    var pid = el.dataset.trustCount;
    populate(el, pid, true);
  });
})();
</script>

{% schema %}
{
  "name": "Inline Star Rating",
  "target": "section",
  "settings": [
    { "type": "header",   "content": "Stars" },
    { "type": "color",    "id": "star_color", "label": "Star Color",         "default": "#F59E0B" },
    { "type": "range",    "id": "star_size",  "label": "Star Size",          "min": 12, "max": 40, "step": 1,  "default": 18 },
    { "type": "range",    "id": "star_gap",   "label": "Gap Between Stars",  "min": 0,  "max": 12, "step": 1,  "default": 2  },
    { "type": "header",   "content": "Rating Text" },
    { "type": "checkbox", "id": "show_text",  "label": "Show rating text",   "default": true },
    { "type": "color",    "id": "text_color", "label": "Text Color",         "default": "#555555" },
    {
      "type": "select",
      "id": "text_format",
      "label": "Text Format",
      "default": "full",
      "options": [
        { "value": "full",  "label": "4.6 out of 5 based on 1,634 reviews" },
        { "value": "short", "label": "4.6  (1,634 reviews)"               },
        { "value": "count", "label": "1,634 reviews"                       }
      ]
    }
  ]
}
{% endschema %}
