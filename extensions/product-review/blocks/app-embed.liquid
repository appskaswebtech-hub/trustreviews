{% comment %}
  Sitewide engine loader. Unlike the other blocks (target: "section"), this
  one is an app EMBED — turned on once in Theme Editor → App embeds — and
  loads on every page of the theme regardless of how that page's content was
  built. Native theme sections, PageFly, GemPages, Shogun, or any other page
  builder that renders Shopify's standard {{ product }} Liquid objects will
  all pick up the same review.js engine this way, so a "Product Review Form"
  custom-HTML snippet (see Admin → Custom Code) works no matter what built
  the page around it — the block itself doesn't need to be manually placed.
{% endcomment %}
{{ 'review.css' | asset_url | stylesheet_tag }}
<script class="tr-extensions-product-review-blocks-app-embed-script-1">
  var locale_language = `{{ request.locale.iso_code }}`;
  {% if product %}
  // Lets review.js inject Google star-rating (AggregateRating) schema on
  // ANY product page — including ones built entirely by a page builder with
  // no Trust Reviews block on them — since the embed itself always has
  // access to the current product via Liquid, regardless of what built the
  // rest of the page.
  var trEmbedProductId = {{ product.id | json }};
  var trEmbedProductTitle = {{ product.title | json }};
  {% endif %}
</script>
<script src="{{ 'review.js' | asset_url }}" defer class="tr-extensions-product-review-blocks-app-embed-script-2"></script>

{%- comment -%}
  Merchant's Custom CSS & JS (app → Custom Code → Custom CSS & JS), on every
  page, so new stores don't need the "Trust Custom Code" block (still
  supported for stores that already have it). The embed is switched on from
  the dashboard's "Install Widget" button.
{%- endcomment -%}
<style id="tr-custom-css"></style>
<script>
(function () {
  // Custom CSS/JS can be loaded by this block and by the Trust Reviews app
  // embed — whichever runs first does it, so the merchant's JS never runs twice.
  if (window.__trCustomCodeLoaded) return;
  window.__trCustomCodeLoaded = true;
  var BASE = '/apps/review?type=custom-code&shop=' + encodeURIComponent({{ shop.permanent_domain | json }});

  fetch(BASE + '&field=css')
    .then(function (r) { return r.text(); })
    .then(function (css) {
      if (css && css.trim()) document.getElementById('tr-custom-css').textContent = css;
    })
    .catch(function () {});

  fetch(BASE + '&field=js')
    .then(function (r) { return r.text(); })
    .then(function (js) {
      if (js && js.trim()) {
        var sc = document.createElement('script');
        sc.textContent = js;
        document.head.appendChild(sc);
      }
    })
    .catch(function () {});
})();
</script>

{% schema %}
{
  "name": "Trust Reviews Engine",
  "target": "body"
}
{% endschema %}
