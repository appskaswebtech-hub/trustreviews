<div class="review-section">
<button id="open-review" class="review-btn">Write a Review</button>

<div id="review-form" class="review-form" style="display:none">
  <div class="form-header">
    <h3>Write a Review</h3>
    <button class="form-close" onclick="closeReview()">✕</button>
  </div>

  <div class="form-field-row">
    <div class="form-field">
      <label>Your name <span class="required">*</span></label>
      <input type="text" id="name" placeholder="Name" required>
    </div>
  </div>  

  <div class="form-field-row">
    <div class="form-field">
      <label>Your email address <span class="required">*</span></label>
      <input type="email" id="email" placeholder="Email" required>
    </div>
  </div>  
   

  <div class="form-field">
    <label>What would you rate this product? <span class="required">*</span></label>
    <div class="star-rating" id="star-rating">
      <span data-value="1">★</span>
      <span data-value="2">★</span>
      <span data-value="3">★</span>
      <span data-value="4">★</span>
      <span data-value="5">★</span>
    </div>
  </div>

  <div class="form-field">
    <label>Tell us your feedback about the product <span class="required">*</span></label>
    <textarea id="comment" placeholder="Share your experience with this product..." required></textarea>
  </div>

  <div class="form-actions">
    <button onclick="closeReview()" class="cancel-btn">Cancel</button>
    <button onclick="submitReview()" class="submit-btn">Submit</button>
  </div>
</div>

<!-- AVERAGE RATING SUMMARY -->
<div class="review-summary">
  <div class="summary-inner">
    <div class="avg-score">
      <span id="avg-rating">0</span><span class="out-of">/5</span>
    </div>
    <div class="avg-stars" id="avg-stars"></div>
    <div class="total-reviews"><span>Based on</span> <span id="total-reviews">0</span> reviews</div>
  </div>
</div>

<!-- REVIEWS LIST -->
<div class="reviews-section">
  <div class="reviews-toolbar">
    <div class="toolbar-tabs">
      <span class="tab active">Product Reviews</span>
    </div>
    <div class="toolbar-right">

      <!-- SORT DROPDOWN -->
      <div class="sort-wrap">
        <button class="sort-btn" id="sort-btn" onclick="toggleSortMenu()">Sort ▾</button>
        <div class="sort-menu" id="sort-menu" style="display:none">
          <div class="sort-option active" data-sort="newest" onclick="selectSort(this)">Newest First</div>
          <div class="sort-option" data-sort="oldest" onclick="selectSort(this)">Oldest First</div>
          <div class="sort-option" data-sort="highest" onclick="selectSort(this)">Highest Rated</div>
          <div class="sort-option" data-sort="lowest" onclick="selectSort(this)">Lowest Rated</div>
          <div class="sort-option" data-sort="helpful" onclick="selectSort(this)">Most Helpful</div>
        </div>
      </div>

      <!-- SEARCH BOX -->
      <div class="search-wrap">
        <button class="search-btn" id="search-toggle-btn" onclick="toggleSearch()">🔍 Search</button>
        <div class="search-box" id="search-box" style="display:none">
          <input type="text" id="search-input" placeholder="Search reviews..." oninput="renderReviews()">
          <button class="search-clear" onclick="clearSearch()">✕</button>
        </div>
      </div>

    </div>
  </div>

  <!-- NO RESULTS MESSAGE -->
  <div id="no-results" style="display:none" class="no-results">No reviews match your search.</div>

  <div id="review-list"></div>
</div>

<style>
/* ============ BASE ============ */
.review-section {
  width: 100%;
  max-width: 100%;
  margin: 60px 0;
  padding: 0 40px;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  color: #1a1a1a;
}

/* ============ WRITE REVIEW BUTTON ============ */
.review-btn {
  display: inline-block;
  padding: 11px 22px;
  background: #fff;
  color: #1a1a1a;
  border: 1.5px solid #1a1a1a;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  border-radius: 3px;
  letter-spacing: 0.3px;
  transition: background 0.18s, color 0.18s;
  margin-bottom: 28px;
}
.review-btn:hover {
  background: #1a1a1a;
  color: #fff;
}

/* ============ FORM ============ */
.review-form {
  background: #fff;
  border: 1.5px solid #e5e5e5;
  border-radius: 6px;
  padding: 30px 30px 24px;
  margin-bottom: 32px;
}
.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}
.form-header h3 {
  font-size: 17px;
  font-weight: 700;
  margin: 0;
}
.form-close {
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: #888;
  line-height: 1;
  padding: 0;
}
.form-close:hover { color: #333; }

.form-field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 16px;
}
@media (max-width: 600px) {
  .form-field-row { grid-template-columns: 1fr; }
}

.form-field {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
}
.form-field label {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 7px;
  color: #333;
}
.required { color: #e53935; }

.form-field input,
.form-field textarea {
  padding: 10px 13px;
  border: 1.5px solid #ddd;
  border-radius: 4px;
  font-size: 14px;
  font-family: inherit;
  color: #1a1a1a;
  background: #fafafa;
  transition: border-color 0.15s;
  outline: none;
}
.form-field input:focus,
.form-field textarea:focus {
  border-color: #1a1a1a;
  background: #fff;
}
.form-field textarea {
  min-height: 110px;
  resize: vertical;
}

/* ============ STAR RATING ============ */
.star-rating {
  display: flex;
  gap: 4px;
  font-size: 30px;
  cursor: pointer;
  margin-top: 4px;
}
.star-rating span {
  color: #ddd;
  transition: color 0.12s, transform 0.1s;
  line-height: 1;
}
.star-rating span.active { color: #f5a623; }
.star-rating span:hover { transform: scale(1.15); }

/* ============ FORM ACTIONS ============ */
.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}
.submit-btn {
  padding: 10px 26px;
  background: #1a1a1a;
  color: #fff;
  border: none;
  border-radius: 3px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.18s;
}
.submit-btn:hover { background: #333; }
.cancel-btn {
  padding: 10px 20px;
  background: #fff;
  color: #555;
  border: 1.5px solid #ddd;
  border-radius: 3px;
  font-size: 14px;
  cursor: pointer;
  transition: border-color 0.15s;
}
.cancel-btn:hover { border-color: #999; }

/* ============ SUMMARY ============ */
.review-summary {
  border: 1.5px solid #e5e5e5;
  border-radius: 6px;
  padding: 24px;
  margin: 28px 0;
  background: #fff;
  text-align: center;
}
.avg-score {
  font-size: 38px;
  font-weight: 800;
  line-height: 1;
  color: #1a1a1a;
}
.out-of {
  font-size: 22px;
  font-weight: 400;
  color: #888;
}
.avg-stars {
  font-size: 22px;
  color: #f5a623;
  margin: 7px 0 5px;
}
.total-reviews {
  font-size: 13px;
  color: #888;
}

/* ============ REVIEWS SECTION ============ */
.reviews-section { margin-top: 32px; }
.reviews-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2px solid #e5e5e5;
  padding-bottom: 0;
  margin-bottom: 0;
  flex-wrap: wrap;
  gap: 8px;
}
.toolbar-tabs { display: flex; gap: 0; }
.tab {
  font-size: 14px;
  font-weight: 600;
  padding: 12px 18px 14px;
  cursor: pointer;
  color: #aaa;
  border-bottom: 2.5px solid transparent;
  margin-bottom: -2px;
  transition: color 0.15s, border-color 0.15s;
}
.tab.active {
  color: #1a1a1a;
  border-bottom-color: #1a1a1a;
}
.toolbar-right {
  display: flex;
  gap: 10px;
  align-items: center;
  padding-bottom: 6px;
  flex-wrap: wrap;
}

/* ============ SORT ============ */
.sort-wrap { position: relative; }
.sort-btn {
  font-size: 13px;
  color: #555;
  cursor: pointer;
  padding: 6px 12px;
  border: 1px solid #ddd;
  border-radius: 3px;
  background: #fafafa;
  transition: background 0.15s;
  white-space: nowrap;
}
.sort-btn:hover, .sort-btn.open { background: #f0f0f0; border-color: #bbb; }
.sort-menu {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  background: #fff;
  border: 1.5px solid #e0e0e0;
  border-radius: 5px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.10);
  z-index: 100;
  min-width: 160px;
  overflow: hidden;
}
.sort-option {
  padding: 10px 16px;
  font-size: 13px;
  color: #333;
  cursor: pointer;
  transition: background 0.12s;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
.sort-option:hover { background: #f5f5f5; }
.sort-option.active {
  font-weight: 700;
  color: #1a1a1a;
  background: #f0f0f0;
}

/* ============ SEARCH ============ */
.search-wrap { position: relative; display: flex; align-items: center; gap: 6px; }
.search-btn {
  font-size: 13px;
  color: #555;
  cursor: pointer;
  padding: 6px 12px;
  border: 1px solid #ddd;
  border-radius: 3px;
  background: #fafafa;
  transition: background 0.15s;
  white-space: nowrap;
}
.search-btn:hover, .search-btn.open { background: #f0f0f0; border-color: #bbb; }
.search-box {
  display: flex;
  align-items: center;
  border: 1.5px solid #1a1a1a;
  border-radius: 3px;
  background: #fff;
  overflow: hidden;
  animation: slideIn 0.15s ease;
}
@keyframes slideIn {
  from { opacity: 0; transform: translateX(8px); }
  to   { opacity: 1; transform: translateX(0); }
}
.search-box input {
  border: none;
  outline: none;
  padding: 6px 10px;
  font-size: 13px;
  font-family: inherit;
  color: #1a1a1a;
  width: 180px;
  background: transparent;
}
.search-clear {
  background: none;
  border: none;
  cursor: pointer;
  color: #aaa;
  font-size: 14px;
  padding: 0 8px;
  line-height: 1;
  transition: color 0.12s;
}
.search-clear:hover { color: #1a1a1a; }

/* ============ NO RESULTS ============ */
.no-results {
  padding: 32px 0;
  text-align: center;
  color: #aaa;
  font-size: 14px;
}

/* ============ REVIEW CARD ============ */
.review-card {
  display: flex;
  gap: 20px;
  padding: 24px 0;
  border-bottom: 1px solid #eeeeee;
  align-items: flex-start;
}
.review-avatar {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  background: #1a1a1a;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.review-body { flex: 1; min-width: 0; }
.review-stars {
  font-size: 17px;
  color: #f5a623;
  margin-bottom: 4px;
  display: flex;
  gap: 2px;
}
.review-stars .dim { color: #ddd; }
.review-product-label {
  font-size: 13px;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 4px;
}
.review-author {
  font-size: 13px;
  color: #888;
  margin-bottom: 8px;
}
.review-comment {
  font-size: 14px;
  color: #333;
  line-height: 1.6;
  margin: 0 0 12px;
}
.review-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}
.helpful-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  background: none;
  border: 1.2px solid #ddd;
  border-radius: 3px;
  padding: 5px 12px;
  font-size: 12.5px;
  cursor: pointer;
  color: #555;
  transition: border-color 0.15s, background 0.15s;
}
.helpful-btn:hover { border-color: #1a1a1a; background: #f7f7f7; }
.helpful-btn .check { color: #2e7d32; font-weight: 700; }
.share-btn {
  background: none;
  border: none;
  font-size: 12.5px;
  color: #888;
  cursor: pointer;
  padding: 5px 0;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.share-btn:hover { color: #1a1a1a; }

/* search highlight */
.highlight {
  background: #fff3cd;
  border-radius: 2px;
  padding: 0 1px;
}

@media (max-width: 600px) {
  .review-section { padding: 0 16px; }
  .review-card { gap: 12px; }
  .review-avatar { width: 36px; height: 36px; font-size: 13px; }
  .reviews-toolbar { flex-wrap: wrap; gap: 8px; }
  .toolbar-right { margin-bottom: 6px; }
  .search-box input { width: 130px; }
}
</style>

<script>
const productId = "{{ product.id }}";
const productTitle = {{ product.title | json }};
let rating = 0;
let allReviews = [];
let currentSort = "newest";
let searchQuery = "";

/* ============ OPEN / CLOSE FORM ============ */
document.getElementById("open-review").onclick = function(){
  document.getElementById("review-form").style.display = "block";
  this.style.display = "none";
};
function closeReview(){
  document.getElementById("review-form").style.display = "none";
  document.getElementById("open-review").style.display = "inline-block";
}

/* ============ STAR CLICK ============ */
document.querySelectorAll("#star-rating span").forEach(star => {
  star.addEventListener("click", function(){
    rating = this.dataset.value;
    document.querySelectorAll("#star-rating span").forEach((s, i) => {
      s.classList.toggle("active", i < rating);
    });
  });
  star.addEventListener("mouseover", function(){
    const hv = this.dataset.value;
    document.querySelectorAll("#star-rating span").forEach((s, i) => {
      s.classList.toggle("active", i < hv);
    });
  });
  star.addEventListener("mouseout", function(){
    document.querySelectorAll("#star-rating span").forEach((s, i) => {
      s.classList.toggle("active", i < rating);
    });
  });
});

/* ============ SORT MENU ============ */
function toggleSortMenu(){
  const menu = document.getElementById("sort-menu");
  const btn  = document.getElementById("sort-btn");
  const isOpen = menu.style.display !== "none";
  menu.style.display = isOpen ? "none" : "block";
  btn.classList.toggle("open", !isOpen);
}
function selectSort(el){
  document.querySelectorAll(".sort-option").forEach(o => o.classList.remove("active"));
  el.classList.add("active");
  currentSort = el.dataset.sort;
  document.getElementById("sort-menu").style.display = "none";
  document.getElementById("sort-btn").classList.remove("open");

  /* Update button label */
  document.getElementById("sort-btn").textContent = el.textContent + " ▾";

  renderReviews();
}
/* Close sort menu on outside click */
document.addEventListener("click", function(e){
  if(!e.target.closest(".sort-wrap")){
    document.getElementById("sort-menu").style.display = "none";
    document.getElementById("sort-btn").classList.remove("open");
  }
});

/* ============ SEARCH ============ */
function toggleSearch(){
  const box = document.getElementById("search-box");
  const btn = document.getElementById("search-toggle-btn");
  const isOpen = box.style.display !== "none";
  box.style.display = isOpen ? "none" : "flex";
  btn.classList.toggle("open", !isOpen);
  if(!isOpen) document.getElementById("search-input").focus();
}
function clearSearch(){
  document.getElementById("search-input").value = "";
  searchQuery = "";
  renderReviews();
  document.getElementById("search-input").focus();
}
document.addEventListener("input", function(e){
  if(e.target.id === "search-input"){
    searchQuery = e.target.value.trim().toLowerCase();
    renderReviews();
  }
});

/* ============ INITIALS ============ */
function getInitials(name){
  return (name || "?").trim().split(" ").map(w => w[0]).join("").toUpperCase().slice(0,2) || "?";
}

function escapeHTML(text){
  return String(text || "").replace(/[&<>"']/g, function(char){
    return {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      "\"": "&quot;",
      "'": "&#39;"
    }[char];
  });
}

/* ============ HIGHLIGHT SEARCH TERM ============ */
function highlight(text, query){
  const safeText = escapeHTML(text);
  if(!query) return safeText;
  const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return safeText.replace(new RegExp("(" + escaped + ")", "gi"), '<span class="highlight">$1</span>');
}

/* ============ RENDER REVIEWS (sort + search) ============ */
function renderReviews(){
  const container = document.getElementById("review-list");
  const noResults = document.getElementById("no-results");
  const q = searchQuery;

  /* Filter */
  let filtered = allReviews.filter(r => {
    if(!q) return true;
    return (r.customer || "").toLowerCase().includes(q) ||
           (r.comment  || "").toLowerCase().includes(q);
  });

  /* Sort */
  filtered = filtered.slice().sort((a, b) => {
    if(currentSort === "newest")  return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
    if(currentSort === "oldest")  return new Date(a.createdAt || 0) - new Date(b.createdAt || 0);
    if(currentSort === "highest") return b.rating - a.rating;
    if(currentSort === "lowest")  return a.rating - b.rating;
    if(currentSort === "helpful") return (b.likes || 0) - (a.likes || 0);
    return 0;
  });

  if(filtered.length === 0){
    container.innerHTML = "";
    noResults.style.display = "block";
    return;
  }
  noResults.style.display = "none";
  container.innerHTML = "";

  filtered.forEach(r => {
    let stars = "";
    for(let i = 1; i <= 5; i++){
      stars += i <= r.rating ? '<span>★</span>' : '<span class="dim">★</span>';
    }
    const initials      = getInitials(r.customer);
    const customerHTML  = highlight(r.customer || "", q);
    const commentHTML   = highlight(r.comment  || "", q);
    const productLabel  = escapeHTML(productTitle);

    container.innerHTML += `
      <div class="review-card" id="review-${r.id}">
        <div class="review-avatar">${initials}</div>
        <div class="review-body">
          <div class="review-stars">${stars}</div>
          <div class="review-product-label">${productLabel}</div>
          <div class="review-author">${customerHTML}</div>
          <p class="review-comment">${commentHTML}</p>
          <div class="review-meta">
            <button class="helpful-btn" onclick="likeReview(${r.id})">
              <span class="check">✓</span> Helpful (${r.likes || 0})
            </button>
            <button class="share-btn" onclick="shareReview(${r.id})">Share</button>
          </div>
        </div>
      </div>
    `;
  });
}

/* ============ FETCH REVIEWS ============ */
async function loadReviews(){
  try {
    const res  = await fetch(`/apps/review?productId=${encodeURIComponent(productId)}`);
    if(!res.ok) throw new Error("Unable to load reviews");
    const data = await res.json();
    allReviews = data.reviews || [];

    /* Summary */
    const total = Number(data.total || 0);
    const avgValue = Number(data.averageRating || 0);
    const avg = total ? avgValue.toFixed(1) : "0.0";
    document.getElementById("avg-rating").innerText    = avg;
    document.getElementById("total-reviews").innerText = total;

    let avgStars = "";
    for(let i = 1; i <= 5; i++){
      avgStars += i <= Math.round(avgValue)
        ? '<span>★</span>'
        : '<span style="color:#ddd">★</span>';
    }
    document.getElementById("avg-stars").innerHTML = avgStars;

    renderReviews();
  } catch(e){
    console.error("loadReviews error:", e);
  }
}

/* ============ SUBMIT REVIEW ============ */
async function submitReview(){
  const name    = document.getElementById("name").value.trim();
  const email   = document.getElementById("email").value.trim();
  const comment = document.getElementById("comment").value.trim();
  if(!name || !email || !comment || rating == 0){
    alert("Please fill all fields and select a rating");
    return;
  }
  const data = {
    email: email,
    productId: productId,
    rating: rating,
    comment: comment,
    customer: name
  };
  try {
    const response = await fetch("/apps/review", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data)
    });
    if(!response.ok) throw new Error("Submit failed");
    alert("Review submitted and sent for approval.");
    document.getElementById("name").value    = "";
    document.getElementById("email").value   = "";
    document.getElementById("comment").value = "";
    rating = 0;
    document.querySelectorAll("#star-rating span").forEach(s => s.classList.remove("active"));
    closeReview();
    loadReviews();
  } catch(err){
    alert("Error submitting review");
  }
}

/* ============ LIKE REVIEW ============ */
async function likeReview(id){
  const response = await fetch("/apps/review", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ type: "like", id: id })
  });
  if(!response.ok) return;
  loadReviews();
}

/* ============ SHARE REVIEW ============ */
function shareReview(id){
  const url = window.location.href + "#review-" + id;
  navigator.clipboard.writeText(url);
  alert("Review link copied!");
}

/* ============ INIT ============ */
loadReviews();
</script>

{% schema %}
{
  "name": "Product Review",
  "target": "section",
  "settings": []
}
{% endschema %}
</div>
