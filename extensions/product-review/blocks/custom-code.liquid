<style id="tr-custom-css" class="tr-extensions-product-review-blocks-custom-code-style-1"></style>

<script class="tr-extensions-product-review-blocks-custom-code-script-2">
(function () {
  // Custom CSS/JS can be loaded by this block and by the Trust Reviews app
  // embed — whichever runs first does it, so the merchant's JS never runs twice.
  if (window.__trCustomCodeLoaded) return;
  window.__trCustomCodeLoaded = true;
  var SHOP = {{ shop.permanent_domain | json }};
  var BASE = '/apps/review';

  fetch(BASE + '?type=custom-code&field=css&shop=' + encodeURIComponent(SHOP))
    .then(function (r) { return r.text(); })
    .then(function (css) {
      if (css && css.trim()) {
        document.getElementById('tr-custom-css').textContent = css;
      }
    })
    .catch(function () {});

  fetch(BASE + '?type=custom-code&field=js&shop=' + encodeURIComponent(SHOP))
    .then(function (r) { return r.text(); })
    .then(function (js) {
      if (js && js.trim()) {
        var sc = document.createElement('script');
        sc.textContent = js;
        document.head.appendChild(sc);
      }
    })
    .catch(function () {});
})();
</script>

{% schema %}
{
  "name": "Trust Custom Code",
  "target": "section",
  "settings": []
}
{% endschema %}
