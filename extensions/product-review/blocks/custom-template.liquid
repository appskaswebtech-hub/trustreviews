{{ 'custom-template.css' | asset_url | stylesheet_tag }}

<div
  id="ct-widget-{{ block.id }}"
  class="ct-widget"
  {{ block.shopify_attributes }}
  data-product-id="{{ product.id }}"
  data-block-id="{{ block.id }}"
  data-locale="{{ request.locale.iso_code }}"
  data-shop="{{ shop.permanent_domain }}"
>
  {% if block.settings.heading != blank %}
    <h2 class="ct-heading">{{ block.settings.heading }}</h2>
  {% endif %}
  <div class="ct-loading">Loading reviews…</div>
  <div class="ct-container"></div>
</div>

<script src="{{ 'custom-template.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Custom Template",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What our customers say"
    }
  ]
}
{% endschema %}
